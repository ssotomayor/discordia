<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Load-bearing twice over: macOS denies the mic without
     NSMicrophoneUsageDescription, and WKWebView refuses every cleartext load
     without NSAppTransportSecurity — which is the whole SFU when self-hosting.
     `build.rs` links this into the binary so an unbundled run has it too. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleDisplayName</key>
	<string>Discordia</string>
	<key>CFBundleExecutable</key>
	<string>Discordia</string>
	<key>CFBundleIconFile</key>
	<string>Discordia.icns</string>
	<key>CFBundleIdentifier</key>
	<string>com.discordia.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Discordia</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>10.13</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Discordia uses your camera when you turn it on in a voice channel.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Discordia connects to servers on your local network when you self-host or join one a friend is hosting.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Discordia uses your microphone for voice chat.</string>
</dict>
</plist>
