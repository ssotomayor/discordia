diff --git a/client/src/image_preview.rs b/client/src/image_preview.rs
new file mode 100644
index 0000000..12301d3
--- /dev/null
+++ b/client/src/image_preview.rs
@@ -0,0 +1,139 @@
+use std::io::Cursor;
+
+use base64::Engine as _;
+use image::{ImageDecoder, ImageEncoder, ImageFormat, ImageReader};
+
+const WIDTH: u32 = 640;
+const HEIGHT: u32 = 480;
+const MIN_PIXELS: u64 = 2_000_000;
+
+pub(crate) fn needed(encoded: &str) -> bool {
+    let length = encoded.len().min(65536) / 4 * 4;
+    let Ok(header) =
+        base64::engine::general_purpose::STANDARD.decode(&encoded.as_bytes()[..length])
+    else {
+        return false;
+    };
+    image::codecs::jpeg::JpegDecoder::new(Cursor::new(header)).is_ok_and(|decoder| {
+        let (width, height) = decoder.dimensions();
+        u64::from(width) * u64::from(height) >= MIN_PIXELS
+            && (width > WIDTH || height > HEIGHT)
+            && width <= 8192
+            && height <= 8192
+            && u64::from(width) * u64::from(height) <= 16_000_000
+    })
+}
+
+fn limits() -> image::Limits {
+    let mut limits = image::Limits::default();
+    limits.max_image_width = Some(8192);
+    limits.max_image_height = Some(8192);
+    limits.max_alloc = Some(128 * 1024 * 1024);
+    limits
+}
+
+pub(crate) fn downsample(mime: &'static str, bytes: &[u8]) -> Option<(&'static str, Vec<u8>)> {
+    let format = image::guess_format(bytes).ok()?;
+    if mime != "image/jpeg" || format != ImageFormat::Jpeg {
+        return None;
+    }
+    let mut reader = ImageReader::with_format(Cursor::new(bytes), format);
+    reader.limits(limits());
+    let mut decoder = reader.into_decoder().ok()?;
+    let (width, height) = decoder.dimensions();
+    if !(MIN_PIXELS..=16_000_000).contains(&(u64::from(width) * u64::from(height))) {
+        return None;
+    }
+    let orientation = decoder.orientation().ok()?;
+    let profile = decoder.icc_profile().ok()?;
+    if profile
+        .as_ref()
+        .is_some_and(|bytes| bytes.len() > 1024 * 1024)
+    {
+        return None;
+    }
+    let mut image = image::DynamicImage::from_decoder(decoder).ok()?;
+    image.apply_orientation(orientation);
+    let resized = image.thumbnail(WIDTH, HEIGHT);
+    let mut output = Vec::new();
+    let mut encoder = image::codecs::png::PngEncoder::new_with_quality(
+        &mut output,
+        image::codecs::png::CompressionType::Fast,
+        image::codecs::png::FilterType::Adaptive,
+    );
+    if let Some(profile) = profile {
+        encoder.set_icc_profile(profile).ok()?;
+    }
+    encoder
+        .write_image(
+            resized.as_bytes(),
+            resized.width(),
+            resized.height(),
+            resized.color().into(),
+        )
+        .ok()?;
+    (output.len() <= 1024 * 1024).then_some(("image/png", output))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preview_is_bounded_lossless_encoded_and_preserves_original_bytes() {
+        let image = image::RgbImage::from_fn(2560, 1440, |x, y| {
+            image::Rgb([(x / 16) as u8, (y / 8) as u8, 120])
+        });
+        let mut bytes = Cursor::new(Vec::new());
+        image.write_to(&mut bytes, ImageFormat::Jpeg).unwrap();
+        let original = bytes.into_inner();
+        let copy = original.clone();
+        assert!(needed(
+            &base64::engine::general_purpose::STANDARD.encode(&original)
+        ));
+        let (mime, preview) = downsample("image/jpeg", &original).unwrap();
+        let decoded = image::load_from_memory(&preview).unwrap();
+        assert_eq!(mime, "image/png");
+        assert_eq!((decoded.width(), decoded.height()), (640, 360));
+        assert_eq!(original, copy);
+    }
+
+    #[test]
+    fn small_images_animation_and_invalid_payloads_keep_the_original() {
+        let image = image::RgbImage::new(64, 48);
+        let mut bytes = Cursor::new(Vec::new());
+        image.write_to(&mut bytes, ImageFormat::Png).unwrap();
+        assert!(downsample("image/png", bytes.get_ref()).is_none());
+        let gif = include_bytes!("../tests/fixtures/optimized-profile.gif");
+        assert!(downsample("image/gif", gif).is_none());
+        assert!(downsample("image/png", gif).is_none());
+        assert!(downsample("image/webp", b"RIFF").is_none());
+        assert!(downsample("image/jpeg", b"bad").is_none());
+        assert!(!needed("bad"));
+        assert!(!needed(&("A".repeat(65535) + "éAAA")));
+        let medium = image::RgbImage::new(1024, 768);
+        let mut jpeg = Cursor::new(Vec::new());
+        medium.write_to(&mut jpeg, ImageFormat::Jpeg).unwrap();
+        assert!(!needed(
+            &base64::engine::general_purpose::STANDARD.encode(jpeg.get_ref())
+        ));
+        assert!(downsample("image/jpeg", jpeg.get_ref()).is_none());
+    }
+
+    #[test]
+    fn jpeg_orientation_is_applied_before_resizing() {
+        let image = image::RgbImage::new(1600, 2000);
+        let mut encoded = Cursor::new(Vec::new());
+        image.write_to(&mut encoded, ImageFormat::Jpeg).unwrap();
+        let jpeg = encoded.into_inner();
+        let exif = b"Exif\0\0II*\0\x08\0\0\0\x01\0\x12\x01\x03\0\x01\0\0\0\x06\0\0\0\0\0\0\0";
+        let mut oriented = jpeg[..2].to_vec();
+        oriented.extend_from_slice(&[0xff, 0xe1]);
+        oriented.extend_from_slice(&((exif.len() + 2) as u16).to_be_bytes());
+        oriented.extend_from_slice(exif);
+        oriented.extend_from_slice(&jpeg[2..]);
+        let (_, result) = downsample("image/jpeg", &oriented).unwrap();
+        let decoded = image::load_from_memory(&result).unwrap();
+        assert_eq!((decoded.width(), decoded.height()), (600, 480));
+    }
+}
