# Cargo build artifacts (workspace + per-crate)
/target
**/target

# OS noise
.DS_Store
Thumbs.db

# Editor scratch
*.swp
*~

# Logs / pidfiles
*.log

# Local env overrides (don't commit secrets)
.env
.env.local
.claude/settings.local.json
# Isolated checkouts for parallel Claude Code sessions — never ours to commit.
.claude/worktrees/
discordia-data/
rendezvous-data/

# Node.js — only needed to regenerate Tailwind CSS, not to build.
node_modules/

# tailwind.out.css is committed — needed by asset!() at compile time.
# Regenerate with: cd client && npx @tailwindcss/cli -i assets/tailwind.css -o assets/tailwind.out.css --minify

# Personal Claude Code instructions (not shared with team)
CLAUDE.local.md

# Fetched by the Windows release workflow before `dx bundle` and embedded by
# client/nsis/webview2.nsh — a build input, not source.
client/nsis/MicrosoftEdgeWebview2Setup.exe
