# Public hostname or IP of this VPS — clients must be able to reach it.
# Used to build the LiveKit URL handed to clients.
PUBLIC_HOST=203.0.113.10

# CHANGE THESE. The defaults are LiveKit's well-known dev credentials; leaving
# them on a public box lets anyone mint tokens for your SFU.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-something-at-least-32-chars

# Optional: hex pubkeys that may moderate the seeded Lobby (comma-separated).
DIOXUSFUN_OPERATORS=
