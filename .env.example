# Read by docker-compose.yml. Everything the containers can take is here; a
# commented line is the default. Client-side settings are in docs/OPS.md.

# ── Required ──────────────────────────────────────────────────────────────────

# Public hostname or IP of this machine. Builds every URL handed to clients:
# the SFU, the iroh relay and the TURN relay. Clients must be able to reach it.
PUBLIC_HOST=203.0.113.10

# The gateway, the rendezvous and the SFU must agree on these; compose refuses
# to start without them. Anyone holding the pair can mint tokens for your SFU.
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-something-at-least-32-chars

# ── Server (gateway) ──────────────────────────────────────────────────────────

# Hex pubkeys that may moderate the seeded Lobby, comma-separated.
DIOXUSFUN_OPERATORS=

# Names clients dial besides this machine's own addresses, comma-separated: a
# DNS name or a TLS proxy. A login signed for an address not listed is refused.
# Behind a wss proxy the scheme matters, e.g. wss://app.example.com.
#DIOXUSFUN_PUBLIC_HOSTS=

# iroh relay that introduces friends behind NAT and carries ciphertext when a
# hole punch fails. Usually the rendezvous's: http://<PUBLIC_HOST>:7701
#DIOXUSFUN_RELAY_URL=

# Cap on stored media in bytes; uploads past it are refused. Default 2 GiB.
#DIOXUSFUN_MEDIA_MAX_BYTES=2147483648

# JSON list of {urls, username, credential} attached to every voice grant, for
# a gateway behind NAT that runs its own TURN. Unneeded when the SFU is public.
#DIOXUSFUN_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"c"}]

# SFU URL handed to clients. Default: the bundled LiveKit on PUBLIC_HOST.
#LIVEKIT_URL=ws://203.0.113.10:7880

# ── Rendezvous ────────────────────────────────────────────────────────────────

# How clients reach the iroh relay. Default: http://<PUBLIC_HOST>:7701
#DIOXUSFUN_RENDEZVOUS_RELAY_URL=

# The TURN relay. Hosts whose media ports nobody outside can reach keep their
# calls on their own SFU; friends who cannot reach it are relayed here,
# ciphertext only. Default: turn:<PUBLIC_HOST>:7702?transport=udp
#DIOXUSFUN_RENDEZVOUS_TURN_URL=

# UDP range relayed media is allocated from; compose publishes the same range.
# About eight ports per relayed friend.
#DIOXUSFUN_RENDEZVOUS_TURN_PORTS=7710-7809

# Public IPv4 written into relay allocations. Default: resolved from the TURN
# URL's hostname; set it when that name does not resolve to this machine.
#DIOXUSFUN_RENDEZVOUS_TURN_RELAY_IP=

# HMAC secret behind the time-limited relay credentials. Default: random per
# start, which costs nothing because hosts renew over the control stream.
#DIOXUSFUN_RENDEZVOUS_TURN_SECRET=

# The shared SFU for hosts that have neither a port map nor a relay. Defaults to
# the bundled LiveKit on PUBLIC_HOST, with the key pair above.
#LIVEKIT_URL=ws://203.0.113.10:7880
